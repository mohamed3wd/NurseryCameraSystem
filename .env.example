# Copy this file to `.env` and adjust values for your machine before running
# `docker compose up`. Nothing in this file is a real production secret -
# these are placeholders for local development and demos only.
#
# For any real deployment, generate fresh values for every secret below and
# store them in a proper secret manager rather than a `.env` file.

# ---- SQL Server ------------------------------------------------------------
SQL_SA_PASSWORD=Your_strong_Password123!

# ---- JWT auth (NurseryCamera.Api) -----------------------------------------
# Must be at least 32 characters. Generate with: openssl rand -base64 48
JWT_SIGNING_KEY=CHANGE_ME_use_a_secret_manager_min_32_chars
JWT_ISSUER=NurseryCameraSystem
JWT_AUDIENCE=NurseryCameraSystem.Clients

# ---- Camera secret encryption (AES-256-GCM) --------------------------------
# Base64-encoded 32-byte key used to encrypt camera RTSP credentials at rest.
# Generate with: openssl rand -base64 32
CAMERA_SECRET_ENCRYPTION_KEY=zrpQSMd/4/tmKosNIxzxDadIUFJcijvLcsVcV9tiyBc=

# ---- Media gateway (never exposes RTSP to clients) -------------------------
MEDIA_GATEWAY_API_KEY=CHANGE_ME_media_gateway_shared_secret
MEDIA_GATEWAY_PUBLIC_URL=http://localhost:8088

# ---- CORS: origins allowed to call the API / SignalR hub -------------------
CORS_ORIGIN_PARENT=http://localhost:4200
CORS_ORIGIN_ADMIN=http://localhost:4300
